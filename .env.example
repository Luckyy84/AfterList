# TMDB movie/TV search proxy
# Use one of these server-side values.
# Do NOT prefix these with VITE_; they are read by the Vercel API function.

TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# AniList is OFF by default, independently on server and client.
# https://docs.anilist.co/guide/terms-of-use prohibits competing anime/manga
# trackers (including media data), API backup/storage and mass collection.
# Do not enable for AfterList without explicit written AniList permission
# covering this use and its metadata caching/storage. Keep that permission in
# your compliance records; reference it below (server-only, not a secret).
# Revenue below the commercial threshold does NOT waive the tracker restriction.
# Server requires exact true AND a nonblank permission reference. Client opt-in
# requires a rebuild; it cannot override the authoritative server gate.
# Existing saved records/progress are retained; TMDB remains available.
ANILIST_ENABLED=false
ANILIST_PERMISSION_REFERENCE=
VITE_ANILIST_ENABLED=false

# Supabase Auth
# These are frontend publishable values from your Supabase project.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# AfterList integration API (server-side only; never prefix the secret with VITE_)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
CRON_SECRET=

# Public profiles fail closed. Set true only after applying and verifying the
# profile and RLS migrations in the target environment.
PUBLIC_PROFILES_ENABLED=false

# Public legal details: deliberately unset. Every VITE_ value is public.
# Supply only operator-approved lawful details, never infer a home address.
VITE_LEGAL_OPERATOR_NAME=
VITE_LEGAL_OPERATOR_ADDRESS=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_OPERATOR_DETAILS=
